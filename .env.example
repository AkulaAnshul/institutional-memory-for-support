# ---- LLM (Groq) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# The brief recommends qwen/qwen3-32b, but that model was shut down on 2026-07-17.
# We default to openai/gpt-oss-20b: cheap, fast, and supports tool calling.
# Set GROQ_MODEL=openai/gpt-oss-120b for maximum reply quality.
GROQ_MODEL=openai/gpt-oss-20b

# ---- Hindsight memory ----
# Option A: Hindsight Cloud (recommended for reliability)
#   Sign up at https://ui.hindsight.vectorize.io/signup and add promo MEMHACK99 for $50 credits.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
#
# Option B: self-hosted / embedded Hindsight (no cloud account)
#   docker run -it -p 8888:8888 -p 9999:9999 \
#     -e HINDSIGHT_API_LLM_PROVIDER=groq \
#     -e HINDSIGHT_API_LLM_API_KEY=$GROQ_API_KEY \
#     -v hindsight-data:/home/hindsight/.pg0 ghcr.io/vectorize-io/hindsight:latest
# HINDSIGHT_BASE_URL=http://localhost:8888

# Name of the shared, company-wide memory bank
ORG_BANK_ID=org:acme
